# ---------- OpenAI (option A – direct API) ----------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini

# ---------- Azure OpenAI (option B – takes priority over OPENAI_API_KEY) ----------
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_KEY=your-azure-openai-key
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---------- Text-to-Speech ----------
# TTS_MODEL is used when OPENAI_API_KEY is set (options: tts-1, tts-1-hd)
TTS_MODEL=tts-1

# AZURE_TTS_DEPLOYMENT is used when Azure OpenAI is configured
# AZURE_TTS_DEPLOYMENT=tts

# Voice for narration: alloy | echo | fable | onyx | nova | shimmer
TTS_VOICE=onyx

# ---------- Commentary settings ----------
# How often (in seconds) to generate a commentary clip (default: 10)
COMMENTARY_INTERVAL=10
